#!/usr/bin/env bash
APPIMAGETOOLURL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$(uname -m).AppImage"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../../.." && pwd)"


APP_IMAGE="@SLIC3R_PACKAGE_NAME@_Linux_V@SoftFever_VERSION@.AppImage"

wget ${APPIMAGETOOLURL} -O ../appimagetool.AppImage
chmod +x ../appimagetool.AppImage

if [ -f /.dockerenv ] ; then # Only run if inside of a Docker Container
sed '0,/AI\x02/{s|AI\x02|\x00\x00\x00|}' -i  ../appimagetool.AppImage
fi

mv @SLIC3R_APP_CMD@ AppRun
chmod +x AppRun

cp resources/images/@SLIC3R_APP_KEY@_192px.png @SLIC3R_PACKAGE_NAME@.png
mkdir -p usr/share/icons/hicolor/192x192/apps
cp resources/images/@SLIC3R_APP_KEY@_192px.png usr/share/icons/hicolor/192x192/apps/@SLIC3R_PACKAGE_NAME@.png
cat <<EOF > @SLIC3R_APP_ID@.desktop
[Desktop Entry]
Name=@SLIC3R_APP_NAME@
Exec=AppRun %U
Icon=@SLIC3R_PACKAGE_NAME@
Type=Application
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
Categories=Utility;
MimeType=model/stl;model/3mf;application/vnd.ms-3mfdocument;application/prs.wavefront-obj;application/x-amf;x-scheme-handler/@SLIC3R_APP_URL_SCHEME@;x-scheme-handler/orcaslicer;model/step;
StartupWMClass=@SLIC3R_LINUX_APP_CMD@
EOF

mkdir -p usr/share/applications
cp @SLIC3R_APP_ID@.desktop usr/share/applications/

mkdir -p usr/share/metainfo
cp "${REPO_ROOT}/scripts/flatpak/@SLIC3R_APP_ID@.metainfo.xml" \
  "usr/share/metainfo/@SLIC3R_APP_ID@.metainfo.xml"
cp "${REPO_ROOT}/scripts/flatpak/@SLIC3R_APP_ID@.metainfo.xml" \
  "usr/share/metainfo/@SLIC3R_APP_ID@.appdata.xml"


export ARCH=$(uname -m)

if [ -f /.dockerenv ] ; then # Only run if inside of a Docker Container
  ../appimagetool.AppImage --appimage-extract-and-run . $([ -n "${container}" ] && echo '--appimage-extract-and-run')
else
  ../appimagetool.AppImage . $([ -n "${container}" ] && echo '--appimage-extract-and-run')
fi

mv @SLIC3R_PACKAGE_NAME@-$(uname -m).AppImage ${APP_IMAGE}
chmod +x ${APP_IMAGE}
